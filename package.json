{
  "name": "@shelf/jest-postgres",
  "version": "1.2.3",
  "private": false,
  "description": "Run Jest tests with a local PostgreSQL instance",
  "keywords": [
    "jest",
    "jest environment",
    "jest preset",
    "postgres",
    "postgres local"
  ],
  "repository": "shelfio/jest-postgres",
  "license": "MIT",
  "author": {
    "name": "Dmytro Harazdovskyi",
    "email": "dmytro.harazdovskyi@shelf.io",
    "url": "shelf.io"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.cjs",
      "require": "./lib/index.cjs",
      "default": "./lib/index.cjs"
    },
    "./jest-preset": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.cjs",
      "require": "./lib/index.cjs",
      "default": "./lib/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./lib/index.cjs",
  "files": [
    "jest-preset.cjs",
    "lib/"
  ],
  "scripts": {
    "build": "rm -rf lib/ && pnpm build:types && babel src --out-dir lib --ignore '**/*.test.ts' --extensions '.ts' --out-file-extension '.cjs'",
    "build:types": "tsc --emitDeclarationOnly --declaration --isolatedModules false --declarationDir lib",
    "lint": "oxfmt && eslint . --ext .js,.ts,.json --fix",
    "lint:ci": "oxfmt --check && eslint . --ext .js,.ts,.json",
    "prepack": "pnpm build",
    "test": "jest",
    "type-check": "tsc --noEmit",
    "type-check:watch": "pnpm type-check -- --watch"
  },
  "packageManager": "pnpm@11.8.0",
  "babel": {
    "extends": "@shelf/babel-config/backend"
  },
  "jest": {
    "preset": "./jest-preset.cjs"
  },
  "dependencies": {
    "cwd": "0.10.0",
    "debug": "4.3.4",
    "postgres": "3.4.3"
  },
  "devDependencies": {
    "@babel/cli": "7.28.6",
    "@babel/core": "7.29.6",
    "@shelf/babel-config": "3.0.0",
    "@shelf/eslint-config": "6.3.0",
    "@shelf/prettier-config": "1.1.1",
    "@shelf/tsconfig": "0.2.0",
    "@types/cwd": "0.10.2",
    "@types/debug": "4.1.12",
    "@types/jest": "30.0.0",
    "@types/minimatch": "6",
    "@types/node": "25",
    "cwd": "0.10.0",
    "eslint": "10.1.0",
    "husky": "9.1.7",
    "jest": "30.3.0",
    "knex": "3.2.6",
    "lint-staged": "16.4.0",
    "oxfmt": "0.42.0",
    "pg": "8.20.0",
    "typescript": "5.3.3"
  },
  "peerDependencies": {
    "jest-environment-node": "27.x.x || 28.x || 29.x",
    "pg": "*"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "lint-staged": {
    "*.{html,md,yml}": [
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{ts,js,json}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "eslint --fix"
    ]
  }
}
